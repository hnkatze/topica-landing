---
/**
 * Foundation preview. Not the landing: it renders every token, font, shadow and
 * motion primitive so the global layer can be verified visually before any
 * section component exists.
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const brand = [
	{ token: 'primary', hex: '#00652C', use: 'Primario · activo' },
	{ token: 'primary-container', hex: '#15803D', use: 'Acción sólida' },
	{ token: 'secondary', hex: '#835425', use: 'Secundario · logística' },
	{ token: 'tertiary', hex: '#754F26', use: 'Terciario · waybills' },
	{ token: 'kraft-ink', hex: '#8B5A2B', use: 'Tinta kraft' },
	{ token: 'on-surface', hex: '#131B2E', use: 'Texto principal' },
	{ token: 'on-surface-variant', hex: '#3F493F', use: 'Texto secundario' },
];

const surfaces = [
	{ token: 'background', hex: '#FAF8FF', use: 'Canvas' },
	{ token: 'surface-lowest', hex: '#FFFFFF', use: 'Tarjetas' },
	{ token: 'surface-low', hex: '#F2F3FF', use: 'Sección alterna' },
	{ token: 'surface-container', hex: '#EAEDFF', use: 'Hover / chip' },
	{ token: 'surface-high', hex: '#E2E7FF', use: 'Franja de confianza' },
	{ token: 'surface-highest', hex: '#DAE2FD', use: 'Realce' },
	{ token: 'kraft-surface', hex: '#F5EBE1', use: 'Bloque logístico' },
	{ token: 'outline-variant', hex: '#BECABC', use: 'Borde de tarjeta' },
];

const semantics = [
	{ token: 'whatsapp', hex: '#25D366', use: 'Canal WhatsApp' },
	{ token: 'paid', hex: '#DCFCE7', use: 'Pagado · fondo' },
	{ token: 'paid-line', hex: '#86EFAC', use: 'Pagado · borde' },
	{ token: 'pending', hex: '#D97706', use: 'Contra entrega' },
	{ token: 'pending-ink', hex: '#92400E', use: 'Pendiente · texto' },
	{ token: 'danger', hex: '#DC2626', use: 'Falta crítica' },
];

const typeScale = [
	{ cls: 'text-hero', label: 'hero · Jakarta 26/32 → 44/52 en sm', text: 'Vende en línea sin contratar a nadie.' },
	{ cls: 'text-headline-xl', label: 'headline-xl · Jakarta 32/40 · 800', text: 'Tu catálogo, inventario y envíos' },
	{ cls: 'text-headline-lg', label: 'headline-lg · Jakarta 24/32 · 700', text: 'Cobra sin cuadernos' },
	{ cls: 'text-headline-md', label: 'headline-md · Jakarta 20/28 · 600', text: 'Pedidos del día' },
	{ cls: 'text-headline-sm', label: 'headline-sm · Jakarta 18/24 · 600', text: 'Empacado · En ruta' },
	{ cls: 'text-body-lg', label: 'body-lg · Inter 16/24 · 400', text: 'Registra la venta desde el mostrador y comparte el recibo por WhatsApp.' },
	{ cls: 'text-body-md', label: 'body-md · Inter 14/20 · 400', text: 'Inventario ajustado al instante, sin hojas de cálculo.' },
	{ cls: 'text-body-sm', label: 'body-sm · Inter 12/16 · 400', text: 'Precios en lempiras, redondeados a dos decimales.' },
	{ cls: 'text-label-lg', label: 'label-lg · Inter 14/20 · 600', text: 'Contra entrega' },
	{ cls: 'text-label-md', label: 'label-md · Inter 12/16 · 500', text: 'Sin existencias' },
	{ cls: 'text-correlative uppercase', label: 'mono-correlative · JetBrains 13/18 · 600', text: 'CAI 8F3A-2C1B-9D4E' },
	{ cls: 'text-currency', label: 'mono-currency · JetBrains 22/28 · 700', text: 'L. 1,450.00' },
];

const icons = [
	'material-symbols:shopping-cart',
	'material-symbols:package-2',
	'material-symbols:local-shipping',
	'material-symbols:receipt-long',
	'material-symbols:storefront',
	'material-symbols:check',
	'material-symbols:bar-chart',
	'material-symbols:verified-user',
	'simple-icons:whatsapp',
];
---

<Layout
	title="Foundation · Topica"
	description="Vista previa de tokens, tipografía, iconos y movimiento del sistema Mercado Kraft."
>
	<meta slot="head" name="robots" content="noindex" />

	<main id="contenido" class="mx-auto w-full max-w-page px-margin py-16">
		<header class="mb-16">
			<p class="text-correlative uppercase text-on-surface-variant">Mercado Kraft · foundation</p>
			<h1 class="mt-3 text-headline-xl text-on-surface">Capa global</h1>
			<p class="mt-4 max-w-prose text-body-lg text-on-surface-variant">
				Tokens, tipografía, iconos y movimiento extraídos del sistema de diseño en Stitch. Las
				secciones de la landing se construyen sobre esta base.
			</p>
		</header>

		<section class="mb-16" data-reveal>
			<h2 class="text-headline-lg">Color</h2>
			<h3 class="mt-6 text-headline-sm text-on-surface-variant">Marca</h3>
			<ul class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
				{
					brand.map((c) => (
						<li class="rounded-lg border border-outline-variant/50 bg-surface-lowest p-3 shadow-card">
							<div class="h-14 rounded-md border border-outline-variant/40" style={`background:${c.hex}`} />
							<p class="mt-3 text-correlative text-on-surface">{c.token}</p>
							<p class="text-body-sm text-on-surface-variant">{c.hex}</p>
							<p class="mt-1 text-label-md text-on-surface-variant">{c.use}</p>
						</li>
					))
				}
			</ul>

			<h3 class="mt-8 text-headline-sm text-on-surface-variant">Superficies</h3>
			<ul class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
				{
					surfaces.map((c) => (
						<li class="rounded-lg border border-outline-variant/50 bg-surface-lowest p-3 shadow-card">
							<div class="h-10 rounded-md border border-outline-variant/40" style={`background:${c.hex}`} />
							<p class="mt-3 text-correlative text-on-surface">{c.token}</p>
							<p class="text-body-sm text-on-surface-variant">{c.hex}</p>
							<p class="mt-1 text-label-md text-on-surface-variant">{c.use}</p>
						</li>
					))
				}
			</ul>

			<h3 class="mt-8 text-headline-sm text-on-surface-variant">Estados</h3>
			<ul class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3">
				{
					semantics.map((c) => (
						<li class="rounded-lg border border-outline-variant/50 bg-surface-lowest p-3 shadow-card">
							<div class="h-10 rounded-md border border-outline-variant/40" style={`background:${c.hex}`} />
							<p class="mt-3 text-correlative text-on-surface">{c.token}</p>
							<p class="text-body-sm text-on-surface-variant">{c.use}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-16" data-reveal>
			<h2 class="text-headline-lg">Tipografía</h2>
			<ul class="mt-6 space-y-5">
				{
					typeScale.map((t) => (
						<li class="border-b border-surface-container pb-4">
							<p class="text-correlative uppercase text-on-surface-variant">{t.label}</p>
							<p class={`mt-1 text-on-surface ${t.cls}`}>{t.text}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-16" data-reveal>
			<h2 class="text-headline-lg">Forma y elevación</h2>
			<div class="mt-6 grid gap-4 md:grid-cols-3">
				<div class="rounded-lg border border-outline-variant/50 bg-surface-lowest p-5 shadow-card">
					<p class="text-headline-sm">L1 · Tarjeta</p>
					<p class="mt-2 text-body-md text-on-surface-variant">border + shadow-card</p>
				</div>
				<div class="rounded-xl border border-kraft-line bg-kraft-surface p-5">
					<p class="text-headline-sm">L2 · Logística</p>
					<p class="mt-2 text-correlative text-kraft-ink">TRK-004822</p>
					<hr class="my-3 border-t border-dashed border-manila-line" />
					<p class="text-body-sm text-kraft-ink">Waybill de despacho</p>
				</div>
				<div class="rounded-lg border border-outline-variant bg-surface-lowest p-5 shadow-counter">
					<p class="text-headline-sm">L3 · Acción fija</p>
					<p class="mt-2 text-body-md text-on-surface-variant">shadow-counter</p>
				</div>
			</div>
			<div class="mt-6 flex flex-wrap items-end gap-4">
				<div class="grid h-16 w-24 place-items-center rounded-xs bg-primary-container text-label-md text-on-primary">xs 2px</div>
				<div class="grid h-16 w-24 place-items-center rounded-sm bg-primary-container text-label-md text-on-primary">sm 2px</div>
				<div class="grid h-16 w-24 place-items-center rounded-md bg-primary-container text-label-md text-on-primary">md 6px</div>
				<div class="grid h-16 w-24 place-items-center rounded-lg bg-primary-container text-label-md text-on-primary">lg 8px</div>
				<div class="grid h-16 w-24 place-items-center rounded-xl bg-primary-container text-label-md text-on-primary">xl 12px</div>
			</div>
		</section>

		<section class="mb-16" data-reveal>
			<h2 class="text-headline-lg">Iconos</h2>
			<p class="mt-2 text-body-md text-on-surface-variant">material-symbols para UI · simple-icons para marcas</p>
			<ul class="mt-4 flex flex-wrap gap-3">
				{
					icons.map((name) => (
						<li class="grid size-12 place-items-center rounded-md border border-outline-variant/50 bg-surface-lowest text-on-surface shadow-card">
							<Icon name={name} size={22} />
						</li>
					))
				}
			</ul>
		</section>

		<section data-reveal>
			<h2 class="text-headline-lg">Movimiento</h2>
			<p class="mt-2 max-w-prose text-body-md text-on-surface-variant">
				CSS + IntersectionObserver. Cada bloque entra una sola vez; con
				<code class="rounded-xs bg-surface-container px-1">prefers-reduced-motion</code> el estado
				final se muestra de inmediato.
			</p>
			<div class="mt-6 grid gap-3 md:grid-cols-3">
				{
					[0, 1, 2].map((i) => (
						<div
							class="reveal rounded-lg border border-outline-variant/50 bg-surface-lowest p-5 shadow-card"
							data-reveal
							style={`--i:${i}`}
						>
							<p class="text-correlative text-on-surface-variant">--i: {i}</p>
							<p class="mt-1 text-headline-sm">Bloque escalonado</p>
						</div>
					))
				}
			</div>
			<div class="mt-6 flex flex-wrap gap-3">
				<span class="btn-shimmer press grid h-touch place-items-center rounded-xl bg-primary-container px-6 text-label-lg text-on-primary">
					Primario · Cobrar
				</span>
				<span class="press grid h-touch place-items-center rounded-xl bg-secondary px-6 text-label-lg text-on-primary">
					Logística · Despachar
				</span>
				<span class="press grid h-touch place-items-center rounded-xl bg-whatsapp px-6 text-label-lg text-on-primary">
					Compartir por WhatsApp
				</span>
				<span class="press grid h-touch place-items-center rounded-xl border border-outline-variant px-6 text-label-lg text-on-surface">
					Secundario
				</span>
			</div>
			<div class="mt-6 grid gap-3 md:grid-cols-3">
				<div class="lift rounded-lg border border-outline-variant/50 bg-surface-lowest p-5 shadow-card">
					<p class="text-headline-sm">.lift</p>
					<p class="text-body-sm text-on-surface-variant">Hover eleva y proyecta</p>
				</div>
				<div class="animate-float-soft rounded-lg border border-outline-variant/50 bg-surface-lowest p-5 shadow-card">
					<p class="text-headline-sm">animate-float-soft</p>
					<p class="text-body-sm text-on-surface-variant">Flotación del panel</p>
				</div>
				<div class="rounded-lg border border-outline-variant/50 bg-surface-lowest p-5 shadow-card">
					<p class="flex items-center gap-2 text-headline-sm">
						<span class="radar-pulse inline-block size-2.5 rounded-full bg-primary-container text-primary-container"></span>
						radar-pulse
					</p>
					<p class="text-body-sm text-on-surface-variant">Indicador en vivo</p>
				</div>
			</div>
		</section>
	</main>
</Layout>
