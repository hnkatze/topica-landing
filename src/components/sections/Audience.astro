---
/**
 * Audience — for whom this is, and for whom it is not.
 *
 * Two columns ported from the Stitch export (`10.html`). The copy spec has no
 * heading for either column, so the column meaning is carried by the icon plus
 * the items themselves; no copy is invented here.
 */
import Icon from '../Icon.astro';
import { audience } from '../../content/landing';
---

<section class="w-full py-space-xl px-margin bg-background">
	<div class="mx-auto max-w-page">
		<h2 class="max-w-3xl text-headline-xl text-on-surface">{audience.title}</h2>

		<div class="mt-space-lg grid gap-space-lg md:grid-cols-2">
			<div
				class="reveal flex flex-col gap-space-md rounded-lg border border-outline-variant/50 bg-surface-lowest p-space-lg shadow-card"
				data-reveal
			>
				<Icon
					name="material-symbols:check-circle"
					size={28}
					class="text-primary-container"
					label="Sí"
				/>

				<ul class="flex flex-col gap-space-md">
					{
						audience.yes.map((item) => (
							<li class="flex items-start gap-space-sm">
								<Icon
									name="material-symbols:check"
									size={20}
									class="mt-0.5 shrink-0 text-primary-container"
								/>
								<span class="text-body-md text-on-surface">{item}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div
				class="reveal flex flex-col gap-space-md rounded-lg border border-dashed border-outline-variant bg-surface-low p-space-lg"
				data-reveal
				style="--i: 1"
			>
				<Icon name="material-symbols:cancel" size={28} class="text-danger" label="No" />

				<ul class="flex flex-col gap-space-md">
					{
						audience.no.map((item) => (
							<li class="flex items-start gap-space-sm">
								<Icon name="material-symbols:close" size={20} class="mt-0.5 shrink-0 text-danger" />
								<span class="text-body-md text-on-surface">{item}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
