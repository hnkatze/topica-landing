---
/**
 * "Lo que trae, sin letra chiquita." — the four capability groups.
 *
 * Structure ported from the Stitch export (`08.html`): a two-column card grid,
 * grouped by the job the merchant is doing (sell, administer, comply, report).
 * All copy comes from `src/content/landing.ts`.
 */
import Icon from '../Icon.astro';
import { includes } from '../../content/landing';
---

<section class="w-full py-space-xl px-margin bg-background">
	<div class="mx-auto max-w-page">
		<h2 class="max-w-3xl text-headline-xl text-on-surface">{includes.title}</h2>

		<ul class="mt-space-lg grid gap-space-md md:grid-cols-2">
			{
				includes.groups.map((group, index) => (
					<li
						class="reveal flex flex-col rounded-lg border border-outline-variant/50 bg-surface-lowest p-space-md shadow-card"
						data-reveal
						style={`--i: ${index}`}
					>
						<div class="flex items-center gap-space-sm border-b border-outline-variant/40 pb-space-sm">
							<span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-surface-container text-primary">
								<Icon name={group.icon} size={20} />
							</span>
							<h3 class="text-headline-sm text-on-surface">{group.title}</h3>
						</div>

						<ul class="mt-space-sm flex flex-col gap-space-sm">
							{group.items.map((item) => (
								<li class="flex items-start gap-space-sm">
									<Icon
										name="material-symbols:check"
										size={18}
										class="mt-0.5 shrink-0 text-primary-container"
									/>
									<span class="text-body-md text-on-surface-variant">{item}</span>
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
	</div>
</section>
