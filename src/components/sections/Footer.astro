---
/**
 * Footer — copy spec S9: logo, warehouse/office address, WhatsApp, email,
 * privacy notice and the "Hecho en Honduras." line.
 *
 * Contact details are still `[DEFINIR]` (S7), so they render through the
 * pending marker instead of made-up phone numbers or addresses. No fake links:
 * without a real number there is no WhatsApp URL to point at.
 */
import Icon from '../Icon.astro';
import Pending from '../Pending.astro';
import { brand, footer } from '../../content/landing';

const contacts = [
	{ icon: 'material-symbols:location-on', label: 'Dirección', value: footer.address },
	{ icon: 'simple-icons:whatsapp', label: 'WhatsApp', value: footer.whatsapp },
	{ icon: 'material-symbols:mail', label: 'Correo', value: footer.email },
];
---

<footer class="w-full border-t border-outline-variant/40 bg-surface-low py-space-xl px-margin">
	<div class="mx-auto max-w-page">
		<div class="flex flex-col gap-space-lg md:flex-row md:items-start md:justify-between">
			<div class="flex max-w-sm flex-col gap-space-sm">
				<div class="flex items-center gap-space-xs">
					<span
						class="flex size-9 items-center justify-center rounded-lg bg-primary-container text-headline-sm text-on-primary"
					>
						{brand.monogram}
					</span>
					<span class="text-headline-sm text-on-surface">{brand.name}</span>
				</div>
				<p class="text-body-md text-on-surface-variant">{footer.tagline}</p>
			</div>

			<div class="flex flex-col gap-space-sm">
				<ul class="flex flex-col gap-space-xs">
					{
						contacts.map((contact) => (
							<li class="flex items-start gap-space-sm">
								<Icon name={contact.icon} size={20} class="mt-0.5 shrink-0 text-primary-container" />
								<span class="text-body-md">
									<span class="text-on-surface-variant">{contact.label}:</span>
									{' '}
									<Pending value={contact.value} />
								</span>
							</li>
						))
					}
				</ul>

				<a
					href={footer.privacy.href}
					class="w-fit text-body-md text-on-surface-variant underline-offset-4 hover:text-on-surface hover:underline"
				>
					{footer.privacy.label}
				</a>
			</div>
		</div>

		<p class="mt-space-lg border-t border-outline-variant/40 pt-space-md text-body-sm text-on-surface-variant">
			{footer.madeIn}
		</p>
	</div>
</footer>
