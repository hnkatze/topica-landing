---
/**
 * Footer (`S11`). Ink surface, palm type, the white wordmark — the only surface
 * the logo is legible on (`S18`).
 */
import { brand, footer } from '../../content/landing';
---

<footer class="sec pad bg-ink text-palm">
	<div class="wrap flex flex-col gap-10">
		<div class="flex flex-wrap justify-between gap-12">
			<div class="max-w-[360px]">
				<img
					src={brand.logo}
					alt="Topica"
					width="138"
					height="44"
					class="h-11 w-auto"
					loading="lazy"
					decoding="async"
				/>
				<p class="mt-4 text-[15px] leading-[22px] text-palm/80">{footer.tagline}</p>
			</div>

			<div class="flex flex-wrap gap-12">
				{
					footer.columns.map((column) => (
						<div>
							<h2 class="text-eyebrow font-bold tracking-[0.08em] text-palm/70 uppercase">
								{column.title}
							</h2>
							<ul class="mt-3 flex flex-col gap-2">
								{column.links.map((link) => (
									<li>
										<a
											href={link.href}
											class="text-[15px] text-palm hover:text-white"
											{...('external' in link && link.external
												? { target: '_blank', rel: 'noopener noreferrer' }
												: {})}
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
							{'address' in column && column.address && (
								<address class="mt-3 max-w-[280px] text-[15px] leading-[22px] text-palm/80 not-italic">
									{column.address}
								</address>
							)}
						</div>
					))
				}
			</div>
		</div>

		<div
			class="flex flex-wrap justify-between gap-3 border-t border-palm/20 pt-6 text-[15px] text-palm/70"
		>
			<p>{footer.legal}</p>
			<p>{footer.madeIn}</p>
		</div>
	</div>
</footer>
