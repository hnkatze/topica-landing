---
/**
 * Problem — the four losses a merchant already lives with, then the empathetic
 * closing line. No eyebrow: the copy spec gives this section a single sentence.
 */
import Icon from '../Icon.astro';
import { problem } from '../../content/landing';

/** The closing block arrives after the four cards, so the stagger continues. */
const closingIndex = problem.items.length + 1;
---

<section class="w-full py-space-xl px-margin bg-background">
	<div class="mx-auto max-w-page flex flex-col gap-space-lg">
		<h2 class="reveal max-w-2xl text-headline-lg text-on-surface" data-reveal style="--i:0">
			{problem.title}
		</h2>

		<div class="grid gap-space-md md:grid-cols-2">
			{
				problem.items.map((item, i) => (
					<article
						class="reveal flex items-start gap-space-md rounded-lg border border-outline-variant/50 bg-surface-lowest p-space-md shadow-card"
						data-reveal
						style={`--i:${i + 1}`}
					>
						<Icon name={item.icon} size={26} class="mt-0.5 shrink-0 text-secondary" />
						<div>
							<h3 class="mb-1 text-headline-sm text-on-surface">{item.title}</h3>
							<p class="text-body-md text-on-surface-variant">{item.text}</p>
						</div>
					</article>
				))
			}
		</div>

		<p
			class="reveal rounded-lg bg-surface-low p-space-md text-body-lg text-on-surface-variant"
			data-reveal
			style={`--i:${closingIndex}`}
		>
			{problem.closing}
		</p>
	</div>
</section>
