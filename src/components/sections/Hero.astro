---
/**
 * Hero promo (`S6`).
 *
 * Layout: a centered 980px column over an ink surface, with the mockup's
 * decorative art absolutely positioned and hidden at <=1180. The spinning ring
 * seal is part of the column, not the art: it is the first element of the load
 * cascade.
 *
 * The countdown is the only client-side state that is not a modal: it reads its
 * end date from `data-ends` and never hides the block if the clock is done.
 */
import LineIcon from '../LineIcon.astro';
import { hero, promo } from '../../content/landing';

const chipIcons = ['cart', 'globe', 'box', 'bag'] as const;

const tiles = [
	{
		icon: 'cart' as const,
		label: hero.art.labels.cart,
		style: 'left:13%;top:430px',
		size: 112,
		radius: 31,
		iconSize: 51,
		bg: 'bg-brand-500',
		fg: 'text-white',
		rotate: '-8deg',
		delay: '0s',
	},
	{
		icon: 'bag' as const,
		label: hero.art.labels.bag,
		style: 'right:6%;top:90px',
		size: 124,
		radius: 34,
		iconSize: 57,
		bg: 'bg-palm',
		fg: 'text-ink',
		rotate: '10deg',
		delay: '-2s',
	},
	{
		icon: 'globe' as const,
		label: hero.art.labels.globe,
		style: 'right:15%;top:360px',
		size: 104,
		radius: 29,
		iconSize: 47,
		bg: 'bg-brand-700',
		fg: 'text-white',
		rotate: '-6deg',
		delay: '-4s',
	},
] as const;
---

<section id="inicio" class="herosec relative overflow-hidden bg-ink text-paper">
	<div
		aria-hidden="true"
		class="pointer-events-none absolute bottom-[-320px] left-1/2 h-[640px] w-[1400px] -translate-x-1/2"
		style="background: radial-gradient(closest-side, var(--color-glow), var(--color-glow-deep) 55%, rgb(22 32 12 / 0) 100%); animation: tglow var(--glow-duration) ease-in-out infinite"
	>
	</div>

	<div class="hero-art pointer-events-none absolute inset-0" aria-hidden="true">
		<!-- Isometric cube, the section's one illustration -->
		<div class="absolute" style="left:4%;top:110px">
			<svg width="210" height="220" viewBox="0 0 200 210" aria-hidden="true">
				<polygon points="100,20 180,60 100,100 20,60" fill="#CBC995"></polygon>
				<polygon points="20,60 100,100 100,190 20,150" fill="#636B32"></polygon>
				<polygon points="100,100 180,60 180,150 100,190" fill="#4B5226"></polygon>
			</svg>
			<span
				class="absolute -bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-palm px-2.5 py-1 text-[10px] font-extrabold tracking-[0.08em] whitespace-nowrap text-ink uppercase shadow-label"
			>
				{hero.art.labels.cube}
			</span>
		</div>

		{
			tiles.map((tile) => (
				<div class="absolute" style={tile.style}>
					{/* Rotation lives on the wrapper: the float keyframes own `transform`. */}
					<span class="block" style={`transform:rotate(${tile.rotate})`}>
						<span
							class:list={['puff grid place-items-center', tile.bg, tile.fg]}
							style={`width:${tile.size}px;height:${tile.size}px;border-radius:${tile.radius}px;animation:tfloat var(--float-duration) ease-in-out ${tile.delay} infinite`}
						>
							<LineIcon name={tile.icon} size={tile.iconSize} strokeWidth={2.2} />
						</span>
					</span>
					<span
						class="absolute -bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-palm px-2.5 py-1 text-[10px] font-extrabold tracking-[0.08em] whitespace-nowrap text-ink uppercase shadow-label"
					>
						{tile.label}
					</span>
				</div>
			))
		}

		<span
			class="puff absolute flex items-center justify-center text-2xl font-extrabold text-ink"
			style="right:5%;bottom:110px;width:170px;height:72px;border-radius:24px;background-color:#12ab4d;animation:tfloat var(--float-duration) ease-in-out -1s infinite"
		>
			{hero.art.cai}
		</span>

		<span
			class="absolute rounded-full bg-palm/20"
			style="left:24%;top:70px;width:46px;height:46px;animation:tfloat2 var(--float2-duration) ease-in-out infinite"
		></span>
	</div>

	<div class="wrap wrap-hero relative flex flex-col items-center gap-[26px] text-center">
		<div class="tload relative flex h-[120px] w-[120px] items-center justify-center">
			<svg
				viewBox="0 0 120 120"
				width="120"
				height="120"
				aria-hidden="true"
				style="animation: tspin var(--spin-duration) linear infinite"
			>
				<defs>
					<path id="hero-ring-path" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"></path>
				</defs>
				<text
					fill="#CBC995"
					font-size="12.5"
					letter-spacing="2.6"
					font-weight="800"
					font-family="var(--font-display)"
				>
					<textPath href="#hero-ring-path">{hero.art.ring.repeat(2)}</textPath>
				</text>
			</svg>
			<span
				class="absolute inset-[30px] grid place-items-center rounded-full bg-palm text-ink"
			>
				<LineIcon name="zap" size={28} strokeWidth={2.4} />
			</span>
		</div>

		<span
			class="tload inline-flex items-center gap-2 rounded-full border border-palm-line bg-palm-chip px-4 py-1.5 text-[12px] font-bold tracking-[0.08em] text-palm uppercase"
			style="--load-delay: .05s"
		>
			{hero.eyebrow}
		</span>

		<h1 class="tload h1" style="--load-delay: .1s; margin: -6px 0 0">
			{hero.titleLead}
			<span class="block text-brand-500">{hero.titleAccent}</span>
		</h1>

		<div class="tload flex items-center justify-center" style="--load-delay: .2s">
			<span class="desde">{hero.price.from}</span>
			<span class="pricepill">
				{hero.price.amount}<span class="pricepill-period">{hero.price.period}</span>
			</span>
		</div>

		<p class="tload max-w-[620px] text-lead text-palm/85" style="--load-delay: .25s">
			{hero.lead}
		</p>

		<div class="tload flex flex-wrap justify-center gap-2.5" style="--load-delay: .3s">
			{
				hero.chips.map((chip, index) => (
					<span class="chip border-palm-line bg-palm-chip text-palm">
						<LineIcon name={chipIcons[index]} size={16} strokeWidth={2.2} class="me-1.5" />
						{chip}
					</span>
				))
			}
		</div>

		<div
			class="tload flex flex-col items-center gap-3"
			style="--load-delay: .4s"
		>
			<button type="button" class="btn btn-primary btn-lg tbtn" data-agenda-open>
				{hero.cta}
			</button>
			<span class="flex items-center gap-2 text-[14px] text-palm/75">
				<LineIcon name="shield" size={18} />
				{hero.trust}
			</span>
		</div>

		<div class="tload flex flex-col items-center gap-2.5" style="--load-delay: .5s">
			<span class="text-[13px] font-semibold text-palm/75">{hero.countdown.label}</span>
			<div
				class="flex gap-2"
				data-countdown
				data-ends={promo.endsAt}
				role="timer"
				aria-live="off"
			>
				{
					hero.countdown.units.map((unit) => (
						<span class="timer-cell">
							<span class="timer-num" data-unit={unit.key}>
								00
							</span>
							<span class="timer-unit">{unit.label}</span>
						</span>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-countdown]');

	if (root) {
		const ends = Date.parse(root.dataset.ends ?? '');
		const cells = {
			days: root.querySelector<HTMLElement>('[data-unit="days"]'),
			hours: root.querySelector<HTMLElement>('[data-unit="hours"]'),
			minutes: root.querySelector<HTMLElement>('[data-unit="minutes"]'),
			seconds: root.querySelector<HTMLElement>('[data-unit="seconds"]'),
		};
		const pad = (value: number) => String(value).padStart(2, '0');

		const tick = () => {
			const left = Number.isNaN(ends) ? 0 : Math.max(0, ends - Date.now());
			const totalSeconds = Math.floor(left / 1000);
			const seconds = totalSeconds % 60;
			const minutes = Math.floor(totalSeconds / 60) % 60;
			const hours = Math.floor(totalSeconds / 3600) % 24;
			const days = Math.floor(totalSeconds / 86400);

			if (cells.days) cells.days.textContent = pad(days);
			if (cells.hours) cells.hours.textContent = pad(hours);
			if (cells.minutes) cells.minutes.textContent = pad(minutes);
			if (cells.seconds) cells.seconds.textContent = pad(seconds);
		};

		tick();
		window.setInterval(tick, 1000);
	}
</script>
