---
/**
 * Sticky header (`S5`).
 *
 * Sits below the marquee bar and sticks to the viewport top once the bar scrolls
 * away. From 901px up the links sit inline with the agenda action; below that the
 * action moves into the disclosure panel, because keeping a full pill next to the
 * hamburger left the logo fighting for the same 390px. The panel closes itself
 * when a section link is followed or Escape is pressed.
 */
import { nav } from '../../content/landing';
---

<header class="sticky top-0 z-20 bg-ink-header backdrop-blur-md">
	<div class="flex items-center justify-between gap-3 px-5 py-4 sm:px-12">
		<a href="/" class="flex items-center" aria-label="Topica — inicio">
			<img
				src="/logo-topica-white.svg"
				alt="Topica"
				width="125"
				height="40"
				class="h-10 w-auto"
				decoding="async"
			/>
		</a>

		<nav aria-label="Secciones" class="nav-links">
			{
				nav.links.map((link) => (
					<a
						href={link.href}
						class="text-[15px] font-medium text-palm transition-colors hover:text-white"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				class="btn btn-primary hdrbtn tbtn hidden min-[901px]:inline-flex"
				data-agenda-open
			>
				{nav.cta}
			</button>

			<details class="relative min-[901px]:hidden" data-mobile-menu>
				<summary
					class="flex h-touch w-touch cursor-pointer list-none items-center justify-center rounded-xl border border-palm-line text-palm [&::-webkit-details-marker]:hidden"
					aria-label="Abrir menú"
				>
					<svg
						width="22"
						height="22"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
				</summary>

				<div
					class="absolute end-0 top-[calc(100%+0.75rem)] z-30 w-[min(22rem,calc(100vw-2.5rem))] overflow-hidden rounded-2xl border border-palm-line bg-ink shadow-[0_24px_48px_rgba(0,0,0,0.45)]"
				>
					<nav aria-label="Secciones" class="flex flex-col p-2">
						{
							nav.links.map((link) => (
								<a
									href={link.href}
									class="rounded-lg px-3 py-3 text-[16px] font-medium text-palm hover:bg-white/5 hover:text-white"
								>
									{link.label}
								</a>
							))
						}
					</nav>

					<div class="border-t border-palm-line p-3">
						<button type="button" class="btn btn-primary w-full" data-agenda-open>
							{nav.cta}
						</button>
					</div>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('header [data-mobile-menu]');

	if (menu) {
		// Following a section link would otherwise leave the panel covering the target.
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				menu.open = false;
			});
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) menu.open = false;
		});

		// Native `details` has no outside-click dismissal, which is the gesture
		// everyone reaches for on a phone.
		document.addEventListener('click', (event) => {
			if (!menu.open) return;
			if (!menu.contains(event.target as Node)) menu.open = false;
		});
	}
</script>
