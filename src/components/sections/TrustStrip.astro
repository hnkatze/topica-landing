---
/**
 * Trust strip — the four promises that hold the whole page up.
 *
 * Sits right under the hero on the `surface-high` band. Rendered as a plain
 * block, not a `<section>`: it carries no heading, and an unnamed landmark is
 * worse for screen readers than no landmark at all. Copy comes from `trust` in the
 * content module, icons from the single icon primitive.
 */
import Icon from '../Icon.astro';
import { trust } from '../../content/landing';
---

<div class="w-full bg-surface-high py-space-md px-margin border-y border-outline-variant/20">
	<div class="mx-auto max-w-page grid gap-space-md sm:grid-cols-2 lg:grid-cols-4">
		{
			trust.map((item, i) => (
				<div class="reveal flex items-start gap-space-sm p-space-xs" data-reveal style={`--i:${i}`}>
					<Icon name={item.icon} size={24} class="mt-0.5 shrink-0 text-primary-container" />
					<div class="flex flex-col">
						<p class="text-label-lg text-on-surface">{item.title}</p>
						<p class="text-body-sm text-on-surface-variant">{item.text}</p>
					</div>
				</div>
			))
		}
	</div>
</div>
