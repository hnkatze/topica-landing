---
/**
 * Rotated ink marquee (`S8`) — the transition band between beneficios and
 * cómo funciona. The rotation is clipped by the wrapper so the page never
 * scrolls sideways.
 */
import { bigMarquee } from '../../content/landing';

const sequence = Array.from(
	{ length: bigMarquee.repeats },
	() => bigMarquee.items.map((item) => `${item} ${bigMarquee.separator}`).join(' '),
).join(' ');
---

<div class="overflow-hidden py-6">
	<div class="-mx-5 rotate-[-1.5deg] bg-ink" aria-hidden="true">
		<div class="flex w-max gap-10 py-4" style="animation: tmarq 40s linear infinite">
			<span class="bigmarq text-palm">{sequence}</span>
			<span class="bigmarq text-palm">{sequence}</span>
		</div>
	</div>
</div>
