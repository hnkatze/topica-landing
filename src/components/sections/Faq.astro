---
/**
 * FAQ (`#preguntas`) — native `<details>`/`<summary>` accordion, no JavaScript.
 *
 * Ported from the Stitch export (`12-preguntas.html`), which animated the panel
 * with a script. The native element gives the same interaction with keyboard
 * support and without client JS; only the chevron rotates.
 *
 * Answers carrying the `[DEFINIR]` marker render through `<Pending />` so an
 * undecided answer cannot look finished (copy spec S7).
 */
import Icon from '../Icon.astro';
import Pending from '../Pending.astro';
import { faq } from '../../content/landing';
---

<section id="preguntas" class="w-full scroll-mt-20 py-space-xl px-margin bg-background">
	<div class="mx-auto max-w-page">
		<h2 class="max-w-3xl text-headline-xl text-on-surface">{faq.title}</h2>

		<ul class="mt-space-lg flex flex-col gap-space-sm">
			{
				faq.items.map((item) => (
					<li>
						<details class="group rounded-lg border border-outline-variant/50 bg-surface-lowest p-space-md open:shadow-card">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-space-sm text-left [&::-webkit-details-marker]:hidden">
								<span class="text-headline-sm text-on-surface">{item.question}</span>
								<Icon
									name="material-symbols:expand-more"
									size={24}
									class="shrink-0 text-on-surface-variant transition-transform duration-200 group-open:rotate-180"
								/>
							</summary>
							<div class="mt-space-sm text-body-md text-on-surface-variant">
								<Pending value={item.answer} />
							</div>
						</details>
					</li>
				))
			}
		</ul>
	</div>
</section>
