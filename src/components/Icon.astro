---
/**
 * Single icon primitive. Set packs in use: `material-symbols:*` for UI — the
 * family the Stitch design uses — and `simple-icons:*` for brands (WhatsApp).
 * Icons are inlined SVG at build time: no runtime fetch, no icon font, no extra
 * client JS.
 */
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
	/** Iconify name including its set, e.g. `material-symbols:local-shipping`. */
	name: string;
	/** Square size in pixels. Counter targets need 20-24. */
	size?: number;
	class?: string;
	/** Accessible name. Omit for decorative icons next to a text label. */
	label?: string;
	strokeWidth?: number;
}

const { name, size = 20, class: className = '', label, strokeWidth } = Astro.props;

const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<AstroIcon
	name={name}
	size={size}
	class={className}
	stroke-width={strokeWidth}
	{...a11y}
/>
